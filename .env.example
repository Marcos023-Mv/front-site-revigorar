# Copie este arquivo para ".env" e preencha com os dados reais.
# Nenhuma dessas variáveis é secreta (é um site estático, sem backend) —
# elas existem só para centralizar dados que mudam com frequência, sem
# precisar editar o código das páginas.

# Dados de contato exibidos na página de Contato (com links clicáveis:
# WhatsApp, e-mail e endereço no Google Maps).
VITE_CONTACT_PHONE_DISPLAY=""
VITE_CONTACT_WHATSAPP_NUMBER=""
VITE_CONTACT_HOURS=""
VITE_CONTACT_EMAIL=""
VITE_CONTACT_ADDRESS=""

# Redes sociais exibidas no rodapé.
# Deixe em branco (ou apague a linha) para o ícone correspondente não aparecer.
VITE_SOCIAL_INSTAGRAM=""
VITE_SOCIAL_LINKEDIN=""
VITE_SOCIAL_FACEBOOK=""

# Páginas legais linkadas no rodapé.
# Deixe em branco para o link correspondente não aparecer.
VITE_PRIVACY_POLICY_URL=""
VITE_TERMS_URL=""
